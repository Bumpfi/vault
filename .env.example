# Local development. Copy to .env.local and fill in the Twitch values.

# Postgres and Redis from `docker compose up -d`
DATABASE_URL=postgresql://vault:vault@localhost:5432/vault
REDIS_URL=redis://localhost:6379

# Twitch application (https://dev.twitch.tv/console/apps).
# Its OAuth redirect URL must include:
#   http://localhost:3000/api/auth/callback/twitch
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Where the app runs, and a random secret for signing sessions:
#   openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Optional: comma-separated Twitch user ids allowed to sign up.
ALLOWED_TWITCH_USER_IDS=
