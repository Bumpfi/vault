{
  "name": "vault",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node --env-file=.env.local ./node_modules/vite/bin/vite.js dev --port 3000",
    "worker": "tsx --env-file=.env.local worker/index.ts",
    "build": "vite build && pnpm build:jobs",
    "build:jobs": "esbuild worker=worker/index.ts migrate=src/server/db/migrate.ts --bundle --platform=node --target=node22 --format=cjs --outdir=.output/jobs --out-extension:.js=.cjs --external:pg-native --log-level=warning",
    "start": "node .output/server/index.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local src/server/db/migrate.ts",
    "db:studio": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs studio"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.26",
    "better-auth": "^1.5.3",
    "bullmq": "^5.78.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "hls.js": "^1.6.16",
    "ioredis": "^5.11.1",
    "lucide-react": "^0.577.0",
    "pg": "^8.16.3",
    "radix-ui": "^1.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/nitro-v2-vite-plugin": "^1.155.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.9",
    "esbuild": "^0.28.1",
    "eslint": "^9.20.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  }
}
