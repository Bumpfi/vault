# Deployment settings for docker-compose.prod.yml / docker-compose.coolify.yml.
# Copy to .env next to the compose file (or enter them in your hosting UI).
# Never commit the real file.

# The URL people open, including https://. Also used as Twitch's OAuth
# redirect base, so register <this URL>/api/auth/callback/twitch in the
# Twitch developer console.
BETTER_AUTH_URL=https://vault.home

# Random secret for signing sessions:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# Twitch application (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Database password. Use URL-safe characters only, e.g.:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Optional: comma-separated Twitch user ids allowed to sign up.
ALLOWED_TWITCH_USER_IDS=

# docker-compose.prod.yml only: change if ports 80/443 are taken (unraid's
# web UI uses them by default), e.g. 8080 / 8443.
HTTP_PORT=80
HTTPS_PORT=443
