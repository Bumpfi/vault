# HTTPS for a LAN deployment. Caddy issues the certificate from its own local
# certificate authority, since a private hostname can't get a public one.
# SITE_ADDRESS is the app's public URL (BETTER_AUTH_URL), e.g. https://vault.home
{
	local_certs
	auto_https disable_redirects
}

{$SITE_ADDRESS} {
	reverse_proxy web:3000
}
